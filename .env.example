# ── Client (Vite, 브라우저에 노출됨 — 공개 가능한 값만) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_ORIGIN=https://calcmoum.com

# 카카오 (클라이언트)
VITE_KAKAO_REST_KEY=your-kakao-rest-api-key
VITE_KAKAO_JS_KEY=your-kakao-javascript-key
VITE_KAKAO_REDIRECT_URI=https://calcmoum.com

# ── Server (API 라우트 전용 — 절대 클라이언트/깃에 노출 금지) ──
APP_ORIGIN=https://calcmoum.com
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=https://calcmoum.com

# Supabase service_role 키: RLS를 전부 우회하므로 서버에서만 사용.
# 절대 VITE_ 접두사를 붙이지 말 것 (붙이면 번들에 포함되어 노출됨).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
