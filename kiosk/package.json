{
  "name": "nunusee-kiosk",
  "private": true,
  "version": "1.0.0",
  "description": "누누씨 귀신의 집?! 팝업스토어 키오스크",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite --port 5183\" \"wait-on tcp:5183 && cross-env VITE_DEV_SERVER_URL=http://localhost:5183 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dist": "npm run typecheck && npm run build && electron-builder"
  },
  "dependencies": {
    "phaser": "^3.88.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.filluminate.nunusee.kiosk",
    "productName": "누누씨귀신의집",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  }
}
